{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app window may reach any Gramalyzer server and AI provider over HTTP(S), and open links in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{"url": "https://*"}, {"url": "https://*:*"}, {"url": "http://*"}, {"url": "http://*:*"}]
    }
  ]
}
